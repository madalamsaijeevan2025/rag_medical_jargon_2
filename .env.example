# Copy to .env and fill in ONLY if you want to run WITHOUT Ollama.
# The backend (main.py) reads this at startup. Leave everything blank to
# use local Ollama (the default), or switch later at runtime via the
# Streamlit sidebar or POST /llm/config.

# --- Cloud API fallback (OpenAI-compatible: OpenAI, OpenRouter, Groq, Gemini, ...) ---
LLM_PROVIDER=                  # "api" for the cloud path; blank or "local" = Ollama
API_KEY=                       # your API key (held in process memory; never logged or returned)
API_BASE_URL=                  # e.g. https://api.openai.com/v1 (default), or https://openrouter.ai/api/v1
API_MODEL=                     # vision-capable chat model, e.g. gpt-4o-mini
API_EMBED_MODEL=               # e.g. text-embedding-3-small

# --- Local Ollama (defaults shown; only needed if you override) ---
# OLLAMA_HOST=http://localhost:11434
# VLM_MODEL=qwen3-vl:4b
# EMBED_MODEL=nomic-embed-text
